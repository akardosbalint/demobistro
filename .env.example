# ---------------------------------------------------------------------------
# Zöld Sarok Vegan Bistro — környezeti változók
# Másold le .env néven és töltsd ki a valós értékekkel.
# Az alkalmazás Supabase/Google Workspace/Twilio/Stripe kulcsok NÉLKÜL is elindul:
# ilyenkor demo/mock adatokkal fut, és az e-mail/SMS küldés a konzolra íródik ki.
# ---------------------------------------------------------------------------

# --- Supabase (adatbázis + auth + storage) ----------------------------------
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Csak szerver oldalon használt, RLS-t megkerülő kulcs — SOHA ne kerüljön a klienshez.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Workspace (tranzakciós e-mailek Gmail SMTP-n keresztül) ---------
# A küldő postafiók (pl. asztal@zoldsarok.hu) és egy hozzá tartozó alkalmazásjelszó.
# Alkalmazásjelszó létrehozása: a Workspace fiókon be kell kapcsolni a 2 lépéses
# azonosítást, majd https://myaccount.google.com/apppasswords alatt generálható.
GOOGLE_WORKSPACE_EMAIL=asztal@zoldsarok.hu
GOOGLE_WORKSPACE_APP_PASSWORD=your-16-char-app-password
GOOGLE_WORKSPACE_FROM_NAME="Zöld Sarok"

# --- Twilio (SMS emlékeztetők és visszaigazolások) --------------------------
# https://console.twilio.com
TWILIO_ACCOUNT_SID=ACyour_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+36301234567

# --- Stripe (opcionális asztalfoglalási kaució) ------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- Cron (Vercel Cron / manuális hívás védelme) -----------------------------
# Ha be van állítva, a /api/cron/reminders csak érvényes
# "Authorization: Bearer <CRON_SECRET>" fejléccel hívható.
CRON_SECRET=generate-a-long-random-string
